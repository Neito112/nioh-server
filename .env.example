# Ni-Oh Server Config Template
# ==============================
# Copy file này thành .env và điền giá trị vào.
# File .env KHÔNG được commit lên Git.

# ── LLM (OpenRouter hoặc bất kỳ OpenAI-compatible API) ──────
NIOH_API_KEY=your_openrouter_api_key_here
NIOH_LLM_BASE_URL=https://openrouter.ai/api/v1
NIOH_MODEL=deepseek/deepseek-chat

# ── ASR (Speech-to-Text) — để trống = dùng default xiaozhi ──
# Ví dụ: NIOH_ASR_TYPE=doubao, NIOH_ASR_KEY=...
NIOH_ASR_TYPE=
NIOH_ASR_KEY=

# ── TTS (Text-to-Speech) — để trống = dùng default xiaozhi ──
NIOH_TTS_TYPE=
NIOH_TTS_KEY=

# ── Node Registry (GitHub Gist — dùng để sync nhiều máy) ────
# Tạo token tại: https://github.com/settings/tokens
# Chỉ cần scope: gist
NIOH_GITHUB_TOKEN=
# Tự động điền bởi installer sau lần đầu
NIOH_GIST_ID=
# ID của node này (tự động nếu để trống)
NIOH_NODE_ID=

# ── Cloudflare Tunnel ────────────────────────────────────────
# Để trống = dùng trycloudflare.com (không cần login, free)
# Điền domain = dùng domain tùy chỉnh (cần cf tunnel login trước)
NIOH_CF_DOMAIN=
# Tự động điền sau khi tạo named tunnel
NIOH_CF_TUNNEL_UUID=

# ── Server Ports ─────────────────────────────────────────────
NIOH_WS_PORT=8000
NIOH_HTTP_PORT=8003

# ── Firmware OTA ─────────────────────────────────────────────
# Version firmware Ni-Oh (để firmware check update)
NIOH_FIRMWARE_VERSION=2.5.3
# URL file .bin để firmware tự update (để trống = không có OTA update)
NIOH_FIRMWARE_URL=

